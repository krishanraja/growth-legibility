# Inject these at runtime. Never commit populated credentials. docs/OPERATIONS.md, "Environment", says what reads each.
# Control Center: required by operate and deliver.
CONTROL_CENTER_ENGINE_TOKEN=
CONTROL_CENTER_URL=https://controlcenter.krishraja.com
# The app's export (A4): both or neither. In operate.yml the URL defaults to the A4 route and the token to the engine's
# Control Center bearer until a dedicated LEGIBILITY_EXPORT_TOKEN exists (docs/FAILURES.md F44).
LEGIBILITY_EXPORT_URL=https://legibility.io/api/internal/growth/export
LEGIBILITY_EXPORT_TOKEN=
# Unused by every run: doctor only reports whether it is set.
LEGIBILITY_API_KEY=
